<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs ../windows/tests/Tests.cs (unchanged) against Corner.Core. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CornerTests</AssemblyName>
    <StartupObject>CornerTests.Program</StartupObject>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RollForward>Major</RollForward>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\windows\tests\Tests.cs" Link="Tests.cs" />
    <ProjectReference Include="..\Corner.Core\Corner.Core.csproj" />
  </ItemGroup>
</Project>
